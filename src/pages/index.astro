---
import Layout from '../layouts/Layout.astro';
import CardiffComments from '../components/CardiffComments.svelte';
---

<Layout>
	<main class="min-h-screen py-20 px-6">
		<div class="max-w-xl mx-auto space-y-16">

			<header>
				<p class="font-display text-sm mb-3" style="color:var(--accent)">$ ./cardiff.dev</p>
				<h1 class="font-display text-2xl mb-5" style="color:var(--fg)">Cardiff Dev</h1>
				<p class="text-sm leading-7" style="color:var(--muted)">
					A community for developers in and around Cardiff, Wales.
					We meet monthly, talk about technology, and build things together.
					Whether you're shipping production code or writing your first loop —
					you're welcome here.
				</p>
			</header>

			<section>
				<p class="font-display text-sm mb-4" style="color:var(--accent)">&gt; events</p>
				<div class="pl-4 border-l space-y-1" style="border-color:var(--border)">
					<p class="text-sm" style="color:var(--fg)">Monthly meetup</p>
					<p class="text-sm" style="color:var(--muted)">1st Tuesday · Cardiff · doors 6:30pm, start 7pm</p>
					<a
						href="https://discord.gg/83xdnFmHPd"
						class="inline-block pt-3 text-xs transition-opacity duration-150 hover:opacity-60"
						style="color:var(--muted)"
					>
						→ join Discord for venue &amp; updates
					</a>
				</div>
			</section>

			<section>
				<p class="font-display text-sm mb-4" style="color:var(--accent)">&gt; topics</p>
				<div class="pl-4 border-l" style="border-color:var(--border)">
					<p class="text-sm leading-7" style="color:var(--muted)">
						Web, systems, mobile, DevOps, AI/ML, open source,
						career advice, side projects, and the eternal
						tabs&#8202;vs&#8202;spaces debate.
					</p>
					<p class="text-xs mt-2 opacity-50" style="color:var(--muted)">// all stacks. all levels. no gatekeeping.</p>
				</div>
			</section>

			<section>
				<p class="font-display text-sm mb-4" style="color:var(--accent)">&gt; find_us</p>
				<div class="pl-4 border-l flex flex-wrap gap-x-6 gap-y-2" style="border-color:var(--border)">
					<a href="https://discord.gg/83xdnFmHPd" class="text-sm transition-opacity duration-150 hover:opacity-60" style="color:var(--muted)">Discord ↗</a>
					<a href="https://bsky.app/profile/cardiff.dev" class="text-sm transition-opacity duration-150 hover:opacity-60" style="color:var(--muted)">Bluesky ↗</a>
					<a href="https://reddit.com/r/Cardiff" class="text-sm transition-opacity duration-150 hover:opacity-60" style="color:var(--muted)">Reddit ↗</a>
				</div>
			</section>

			<section>
				<p class="font-display text-sm mb-4" style="color:var(--accent)">&gt; comments</p>
				<div class="pl-4 border-l" style="border-color:var(--border)">
					<CardiffComments
						uri="https://bsky.app/profile/cardiff.dev/post/3lc43kdf2ws2e"
						client:load
					/>
				</div>
			</section>

			<footer class="pt-8 border-t" style="border-color:var(--border)">
				<p class="text-xs opacity-30" style="color:var(--fg)">cardiff.dev · made in wales</p>
			</footer>

		</div>
	</main>
</Layout>
