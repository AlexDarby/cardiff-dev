---
import '../styles/global.css';
interface Props {
	title?: string;
}
const { title = 'Cardiff Dev' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/logo_icon_chosen.png" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
